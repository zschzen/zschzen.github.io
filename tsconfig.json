{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "preserve",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "~/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client",
      "unplugin-vue-router/client"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*",
    "./scripts/**/*",
    "./lab/**/*",
    "./photos/**/*",
    "./*.ts",
    "./*.d.ts"
  ],
  "exclude": ["dist", "node_modules", "public"]
}
